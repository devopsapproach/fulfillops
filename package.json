{
  "name": "capstone",
  "version": "1.0.0",
  "description": "API DevOps Project",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev:api": "tsx watch api/server.ts",
    "dev:worker": "tsx watch worker/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devopsapproach/capstone.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "husky": "^9.1.7",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.10",
    "express": "5.3.0",
    "pg": "8.23.1",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
