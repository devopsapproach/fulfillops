{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "worker/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "prisma/seed.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
