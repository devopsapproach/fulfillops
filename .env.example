NODE_ENV=development
PORT=8080

# PostgreSQL configuration used by Docker Compose.
POSTGRES_USER=fulfillops
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fulfillops_dev
POSTGRES_PORT=5432

# Host-side connections. Keep credentials consistent with PostgreSQL.
DATABASE_URL=postgresql://fulfillops:CHANGE_ME@localhost:5432/fulfillops_dev
TEST_DATABASE_URL=postgresql://fulfillops_test:CHANGE_ME@localhost:5432/fulfillops_test

LOG_LEVEL=info

# Worker configuration for the planned processing implementation.
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_MS=10000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_MS=1000